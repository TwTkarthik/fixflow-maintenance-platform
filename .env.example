# Local Docker Compose values only. Copy to .env and replace placeholders.
# Keep development for the local demo; never use development defaults publicly.
FIXFLOW_ENVIRONMENT=development
POSTGRES_USER=fixflow
POSTGRES_PASSWORD=replace-with-a-local-only-password
POSTGRES_DB=fixflow_dev

# Generate a 32-byte URL-safe secret locally without echoing it in PowerShell:
# $env:JWT_SECRET_KEY = python -c "import secrets; print(secrets.token_urlsafe(32))"
# For production, set FIXFLOW_ENVIRONMENT=production and provide that generated value securely.
# Never commit a real secret or use the placeholder in production.
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# The browser reaches the published backend port from the host.
FIXFLOW_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_BASE_URL=http://localhost:8000
