# PostgreSQL connection URL for the Phase 3 database layer.
# Do not commit backend/.env or real credentials.
# FIXFLOW_ENVIRONMENT defaults to development for the local demo; never use that default publicly.
FIXFLOW_ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://postgres:replace-with-local-password@127.0.0.1:5432/fixflow_dev

# Comma-separated browser origins allowed to call the local API.
FIXFLOW_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Generate a 32-byte URL-safe secret locally without echoing it in PowerShell:
# $env:JWT_SECRET_KEY = python -c "import secrets; print(secrets.token_urlsafe(32))"
# Never commit the generated value or use the placeholder in production.
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
