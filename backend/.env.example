# PostgreSQL connection URL for the Phase 3 database layer.
# Do not commit backend/.env or real credentials.
DATABASE_URL=postgresql+psycopg://postgres:replace-with-local-password@127.0.0.1:5432/fixflow_dev

# Comma-separated browser origins allowed to call the local API.
FIXFLOW_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Authentication configuration. Never commit the real secret.
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
